# Hermes Agent - chief_of_staff profile (Milestone 2, docs/MILESTONE_2_HERMES_DESIGN.md).
# Rendered to config.yaml (gitignored, has the real MCP bearer token) by
# scripts/generate_hermes_config.py - never commit the rendered file.

agent:
  # `memory` disabled here too (Mohit's approval condition 3: "Chief
  # memory must never store raw fetched web content"). chief_of_staff
  # cannot call web_fetch/web_search itself (role_limits,
  # policies/policy.yaml) - the only raw-content path into chief at all
  # is get_research_report's UNTRUSTED-wrapped text, which the researcher
  # itself writes. Rather than trust a system prompt to never copy that
  # into memory (this project's own design rule: permissions enforced in
  # code, not prompts), memory is disabled outright - the same strict,
  # code-level guarantee applied to `skills` and to the researcher's own
  # memory. Revisit only once a real sanitized-memory design exists.
  disabled_toolsets:
    - terminal
    - file
    - code_execution
    - browser
    - web
    - image_gen
    - video_gen
    - video
    - tts
    - vision
    - discord
    - feishu_doc
    - feishu_drive
    - spotify
    - hermes-yuanbao
    - x_search
    - homeassistant
    - desktop_ui
    - project
    - connections
    - setup
    - cronjob
    - delegation
    - kanban
    - skills
    - memory

model:
  provider: custom
  base_url: http://litellm:4000/v1
  # chief_of_staff gets the stronger route (better judgment for
  # coordinating/deciding Tier-2/3 requests) - both routes are $0 models
  # now (configs/litellm_config.yaml), so this is a capability choice, not
  # a cost one.
  default: premium
  key_env: LITELLM_VIRTUAL_KEY_CHIEF

# See researcher's config.yaml.template for why this exists - same fix,
# both models.
model_overrides:
  custom:
    cheap:
      supports_reasoning: false
    premium:
      supports_reasoning: false

mcp_servers:
  burns_gateway:
    url: "http://gateway-mcp:8091/mcp"
    headers:
      Authorization: "Bearer __HERMES_MCP_TOKEN_CHIEF__"
    tools:
      include: [execute_action, get_approval_status, verify_ledger]
