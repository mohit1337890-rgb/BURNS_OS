# ==============================================================================
# BURNS OS - ENVIRONMENT CONFIGURATION
# Copy to ".env" and fill in real values. NEVER commit the real .env.
# Only gateway/ reads these at runtime - no other service/agent may read
# secrets directly (see policies/policy.yaml HARD_BLOCK: reveal_secrets).
# ==============================================================================

# --- Owner / company identity ------------------------------------------------
OWNER_NAME=Mohit
TIMEZONE=Asia/Kolkata

# --- Backups (scripts/backup.py, scripts/restore.py, `make backup`/`make restore`) ---
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_RETENTION_DAYS=14
BACKUP_OFFSITE_DIR=../burns_os_backups_offsite

# --- Telegram (Approvals Bot - separate bot token from any Hermes chat bot) --
# Get a bot token from @BotFather, message it once, then read
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat.id.
# PENDING: not yet provided. The Approvals Bot and Daily Brief cannot send
# anything until both of these are set - see docs/KNOWN_LIMITS.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# --- Budgets ------------------------------------------------------------------
MONTHLY_AI_BUDGET_USD=50
DEFAULT_MISSION_BUDGET_USD=10

# --- Reporting ------------------------------------------------------------------
DAILY_BRIEF_TIME=08:00

# --- Trading Desk risk limits (enforced in code, not just policy - see
# gateway/plugins/place_trade.py) --------------------------------------------
MAX_RISK_PER_TRADE_PCT=1
MAX_DAILY_LOSS_PCT=3

# --- Monitoring -----------------------------------------------------------------
HEARTBEAT_MINUTES=15
HEALTHCHECKS_IO_PING_URL=

# --- Deploy target (informational - see docs/KNOWN_LIMITS.md for the actual
# dev-machine limitation: this repo is authored on Windows without Docker) ---
DEPLOY_TARGET=single Linux VPS (Ubuntu 24.04, Docker), 8 GB RAM

# --- Ledger tail-truncation anchor (core/ledger_anchor.py) -----------------------
LEDGER_ANCHOR_PATH=./data/ledger_anchor.jsonl

# --- Database -------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=burns_os
# burns_admin: Postgres superuser (the official postgres image's own
# bootstrap vars) - migrations ONLY, never given to gateway/approvals_bot/
# scheduler's own environment. See db/migrations/env.py, Makefile's `up`.
POSTGRES_USER=burns_admin
POSTGRES_PASSWORD=
# burns_app: what the Gateway/Approvals Bot/Scheduler actually connect as -
# created by migration 0003 with NOSUPERUSER and only SELECT+INSERT on
# ledger (no UPDATE/DELETE). See KNOWN_LIMITS gap #10.
BURNS_APP_DB_USER=burns_app
BURNS_APP_DB_PASSWORD=

# --- LiteLLM proxy (model router) -----------------------------------------------
LITELLM_MASTER_KEY=
LITELLM_BASE_URL=http://localhost:4000
# Own dedicated Postgres role, owns litellm_db only - zero grants on
# burns_os (docs/incidents/2026-09-litellm-table-drop.md).
LITELLM_DB_USER=litellm_app
LITELLM_DB_PASSWORD=

# --- Langfuse (LLM call tracing/cost, its own separate Postgres db) --------------
LANGFUSE_DB_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# --- Gateway internal auth (agents/services -> gateway) --------------------------
GATEWAY_INTERNAL_TOKEN=

# --- Optional provider keys (only ever read by gateway/, never by an agent) -----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
COOLIFY_API_TOKEN=
COOLIFY_BASE_URL=
